<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#111111">
<title>DJ Manager</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#111;color:#fff;font-family:Arial,sans-serif;padding:20px}
header{text-align:center;padding:22px 0}
h1{color:#00e5ff;font-size:32px;margin:0}
header p{color:#aaa}
.card{background:#222;border-radius:14px;padding:18px;margin:16px 0}
label{display:block;margin:12px 0 6px}
input,textarea{width:100%;padding:12px;border-radius:8px;border:1px solid #444;background:#151515;color:white;font-size:16px}
button{background:#00e5ff;color:#111;border:0;border-radius:8px;padding:12px 16px;font-weight:bold;margin-top:14px;font-size:16px}
.event{border-bottom:1px solid #444;padding:12px 0}
small{color:#aaa}
</style>
</head>
<body>
<header>
<h1>DJ MANAGER</h1>
<p>Organizza le tue serate</p>
</header>

<div class="card">
<h2>🎧 Nuovo evento</h2>
<label>Nome evento</label>
<input id="nome" placeholder="Es. Serata in discoteca">
<label>Locale</label>
<input id="locale" placeholder="Nome del locale">
<label>Data</label>
<input id="data" type="date">
<label>Cachet (€)</label>
<input id="cachet" type="number" placeholder="0">
<label>Note</label>
<textarea id="note" placeholder="Orario, attrezzatura, contatti..."></textarea>
<button onclick="aggiungi()">Salva evento</button>
</div>

<div class="card">
<h2>📅 I tuoi eventi</h2>
<div id="eventi">Nessun evento salvato.</div>
</div>

<script>
let eventi=JSON.parse(localStorage.getItem('djmanager_eventi')||'[]');

function mostra(){
 const area=document.getElementById('eventi');
 if(!eventi.length){
  area.textContent='Nessun evento salvato.';
  return;
 }
 area.innerHTML='';
 eventi.forEach((e,i)=>{
  const div=document.createElement('div');
  div.className='event';
  const titolo=document.createElement('strong');
  titolo.textContent=e.nome;
  const dettagli=document.createElement('p');
  dettagli.textContent=e.locale+' · '+e.data+' · €'+e.cachet;
  const note=document.createElement('small');
  note.textContent=e.note;
  const elimina=document.createElement('button');
  elimina.textContent='Elimina';
  elimina.onclick=()=>{
   eventi.splice(i,1);
   salva();
  };
  div.append(titolo,dettagli,note,document.createElement('br'),elimina);
  area.appendChild(div);
 });
}

function aggiungi(){
 const nome=document.getElementById('nome').value.trim();
 if(!nome){
  alert('Inserisci il nome dell’evento');
  return;
 }
 eventi.push({
  nome:nome,
  locale:document.getElementById('locale').value.trim(),
  data:document.getElementById('data').value,
  cachet:document.getElementById('cachet').value||'0',
  note:document.getElementById('note').value.trim()
 });
 salva();
 ['nome','locale','data','cachet','note'].forEach(id=>{
  document.getElementById(id).value='';
 });
}

function salva(){
 localStorage.setItem('djmanager_eventi',JSON.stringify(eventi));
 mostra();
}

mostra();
</script>
</body>
</html>
